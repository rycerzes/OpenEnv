
# Dockerfile.integration — self-contained container for integration testing
#
# Contains: pi, pi-mcp-adapter, OpenEnv, FileCreatorEnvironment, FastAPI server
#
# Build:
#   docker build -t openenv-integration:latest \
#       -f docker/Dockerfile.integration .
#
# Run:
#   docker run --rm -p 8000:8000 \
#       -e OPENENV_TEST_API_KEY=... \
#       -e OPENENV_TEST_API_URL=... \
#       -e OPENENV_TEST_MODEL=... \
#       openenv-integration:latest

FROM debian:bookworm-slim

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential ca-certificates curl git \
        procps python3 python3-pip python3-venv \
        unzip wget \
    && rm -rf /var/lib/apt/lists/*

# Node.js 22 (for pi) — installed directly, no nvm
RUN curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# Bun (runtime for pi)
RUN curl -fsSL https://bun.sh/install | bash
ENV PATH="/root/.bun/bin:${PATH}"

# pi coding agent + MCP adapter
RUN npm install -g @mariozechner/pi-coding-agent \
    && pi install npm:pi-mcp-adapter

# Python venv + OpenEnv deps
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

# Install uv for fast Python package management
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# Copy OpenEnv source
WORKDIR /app
COPY pyproject.toml uv.lock ./
COPY src/ src/
COPY envs/echo_env/ envs/echo_env/

# Install OpenEnv in the venv
RUN uv pip install --python /opt/venv/bin/python -e ".[dev]"

# Copy integration test environment
COPY tests/integration/file_creator_env.py /app/file_creator_env.py
COPY docker/server_app.py /app/server_app.py
COPY docker/openenv_entrypoint.sh /app/openenv_entrypoint.sh
COPY docker/run_integration_test.py /app/run_integration_test.py
RUN chmod +x /app/openenv_entrypoint.sh

# Workspace for the agent
RUN mkdir -p /workspace

# Expose MCP/HTTP port
EXPOSE 8000

# Default: start the env server
# For testing, override with: docker run ... python /app/run_integration_test.py
CMD ["/app/openenv_entrypoint.sh"]
